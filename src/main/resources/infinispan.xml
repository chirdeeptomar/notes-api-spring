<?xml version="1.0" encoding="UTF-8"?>
<!--
  Infinispan configuration backing Hibernate's second-level cache, via the JCache (JSR-107)
  bridge. Referenced by spring.jpa.properties.hibernate.javax.cache.uri in application.properties.

  CLUSTERING MODE: invalidation, not replicated or distributed. Infinispan's own Hibernate 2LC
  guidance is explicit that replicated/distributed caches with the read-write strategy require
  eviction to be switched off ("eviction should not be used in this configuration as it can lead
  to consistency issues"). An unbounded entity cache is an OOM waiting to happen on a large
  dataset, which is the opposite of what caching is meant to buy here. Invalidation mode keeps
  every node's cache bounded and evictable: each node caches only what it actually read, and a
  write broadcasts a *removal* message so no other node keeps serving the old value. The cluster
  is still a cluster - nodes coordinate on writes - it simply does not replicate the data itself.
  It also needs no marshalling contract on the entities, since entries never leave their node.

  ONE CACHE PER (ENTITY, TENANT). Region names are "<entity FQCN>.<tenant>", created
  programmatically by TenantAwareJCacheRegionFactory from the entity-region template below - not
  declared literally per tenant in this file. Hibernate's cache keys already carry the tenant, so
  this split is not what makes the cache correct - it is what makes each tenant's capacity
  independent, so a tenant running a large scan cannot evict a quieter tenant's hot entries, and
  so per-tenant hit rates and sizes can be read off separately.

  ADDING A TENANT: add the tenant to svc.tenant.* in application.properties, then restart. No
  edit needed here - the region factory derives the tenant list from TenantInfo at boot and
  creates each missing cache from the entity-region template via EmbeddedCacheManager's
  administration API. (Remote mode does not yet support this; see
  infinispan/hotrod-client.properties.)

  ADDING AN ENTITY: add a <cache-template> for it, sized for its own working set. One cache per
  (entity, tenant) is still created automatically from that template - no per-tenant declaration
  needed here either. When svc.tenancy.enabled=false, also declare that entity's bare-named cache
  below (see "com.empyrean.elide.model.Note" below the template) - TenantAwareJCacheRegionFactory
  is not registered in that mode, so nothing creates the cache programmatically, and an
  undeclared region falls through to Hibernate/Infinispan's MissingCacheStrategy default
  (auto-create an unbounded, non-invalidation cache with a different marshalling posture than the
  template - see NOTE_REGION comment below for what that actually broke).
-->
<infinispan xmlns="urn:infinispan:config:16.1"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="urn:infinispan:config:16.1 https://infinispan.org/schemas/infinispan-config-16.1.xsd">

    <cache-container name="notes-api" statistics="true">
        <!--
          "udp" is one of Infinispan's built-in stacks (UDP multicast), fine for local development
          and tests. For a real deployment switch to "tcp" with an explicit discovery protocol, or
          "kubernetes" - multicast is usually unavailable in cloud networks.
        -->
        <transport stack="udp" cluster="notes-api-cluster"/>

        <!--
          Per-entity template. max-count is the per-tenant entry budget: sized for one tenant's
          hot set, not for the whole dataset. A financial entity with a large reference set
          should get its own template with a larger budget rather than inflating this one.

          max-idle expires entries that stop being read, so a tenant that goes quiet releases
          heap without waiting for eviction pressure from other entries.
        -->
        <invalidation-cache-configuration name="entity-region" mode="SYNC" statistics="true">
            <memory max-count="10000"/>
            <expiration max-idle="1800000" interval="60000"/>
        </invalidation-cache-configuration>

        <!--
          NOTE_REGION (svc.tenancy.enabled=false only). Same bounded/invalidation shape as
          entity-region above, declared under Note's bare FQCN because that is the literal region
          name Hibernate's plain default region factory uses when there is no tenant to suffix it
          with (TenantAwareJCacheRegionFactory, which creates the per-tenant caches
          programmatically from the entity-region template, is not registered in that mode - see
          HibernateTenancyConfiguration.cacheRegionFactoryCustomizer). Leaving this region
          undeclared let MissingCacheStrategy auto-create a default cache instead, which failed
          every second-level cache read with "ISPN000615: Unable to unmarshall
          'org.hibernate.cache.internal.BasicCacheKeyImplementation'" - the auto-created cache's
          default marshalling does not know Hibernate's cache-key classes, unlike a declared
          cache using this container's own configuration. Add one such cache per indexed entity
          if more are added while tenancy can be disabled.
        -->
        <invalidation-cache name="com.empyrean.elide.model.Note" mode="SYNC" statistics="true">
            <memory max-count="10000"/>
            <expiration max-idle="1800000" interval="60000"/>
        </invalidation-cache>

        <!--
          Hibernate's internal regions. These are NOT per-tenant: they are keyed by table name and
          query, not by entity id, and Hibernate looks them up under fixed names.

          The timestamps region must never evict or expire. Hibernate uses it to decide whether a
          cached query result is still fresh; losing a timestamp entry makes it treat cached data
          as potentially stale. Infinispan's 2LC guidance calls this out specifically, hence
          replicated (not invalidation) with no <memory> or <expiration> bound.
        -->
        <replicated-cache name="default-update-timestamps-region" mode="ASYNC" statistics="true"/>

        <!--
          Present because the region factory expects it to exist, but unused: query caching is
          switched off (hibernate.cache.use_query_cache=false in application.properties) because
          Hibernate's QueryKey carries no tenant identifier, and under schema-per-tenant every
          tenant generates byte-identical SQL. See the comment on that property.
        -->
        <local-cache name="default-query-results-region" statistics="true">
            <memory max-count="1000"/>
            <expiration max-idle="60000"/>
        </local-cache>
    </cache-container>
</infinispan>
